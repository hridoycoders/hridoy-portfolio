<script is:inline type="module">
  function positionSocialIcons() {
    const center = document.querySelector("#socialCircle");
    const images = document.querySelectorAll(".socialIcon");

    if (!center || !images.length) return;

    const iconSize = images[0].offsetWidth;

    const centerWidth = center.clientWidth;
    const centerHeight = center.clientHeight;

    const centerX = centerWidth / 2;
    const centerY = centerHeight / 2;

    // Icon centers will sit exactly on the dashed circle line
    const radius = Math.min(centerWidth, centerHeight) / 2;

    images.forEach((image, index) => {
      const angle = (index / images.length) * Math.PI * 2 - Math.PI / 2;

      const x = centerX + Math.cos(angle) * radius - iconSize / 2;
      const y = centerY + Math.sin(angle) * radius - iconSize / 2;

      image.style.left = `${x}px`;
      image.style.top = `${y}px`;
    });
  }

  function initializeSocialIcons() {
    requestAnimationFrame(positionSocialIcons);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeSocialIcons);
  } else {
    initializeSocialIcons();
  }

  window.addEventListener("resize", initializeSocialIcons);
</script>
